<bpmn:flowNodeRef>E10</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_proposed_2" name="Bank O (observer)">
<bpmn:flowNodeRef>E11</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_proposed_3" name="Exporter (TH)">
<bpmn:flowNodeRef>E04</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E07</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_proposed_4" name="Logistics / Customs">
<bpmn:flowNodeRef>E05</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E06</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_proposed_5" name="Regulator (audit)">
<bpmn:flowNodeRef>end</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E12</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start" name="Contract signed"><bpmn:outgoing>F0</bpmn:outgoing></bpmn:startEvent>
<bpmn:endEvent id="end" name="Settled &amp; auditable"><bpmn:incoming>F21</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="end_rej" name="Escrow rejected"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="end_ref" name="Refunded/Terminated"><bpmn:incoming>F18</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="G0" name="Creation KYC?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G1" name="Docs PASS?"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G2" name="Release guard"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="E01" name="E01 Create &amp; fund escrow request"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.25, 0.5, 1)</bpmn:documentation><bpmn:incoming>F0</bpmn:incoming><bpmn:outgoing>F1</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="E02" name="E02 Creation KYC/AML screening"><bpmn:documentation>kind=AUTO; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.0, 0.0, 0.0)</bpmn:documentation><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="E03" name="E03 Lock tokenised deposits"><bpmn:documentation>kind=AUTO; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.0, 0.0, 0.0)</bpmn:documentation><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="E04" name="E04 Prepare goods &amp; export declaration"><bpmn:documentation>kind=MANUAL; segment=COMMON; path=MAIN; assumed duration days low/base/high=(3, 5, 7)</bpmn:documentation><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:userTask>
<bpmn:manualTask id="E05" name="E05 Clear export customs; submit declaration"><bpmn:documentation>kind=EXTERNAL_MANUAL; segment=COMMON; path=MAIN; assumed duration days low/base/high=(0.5, 1, 2)</bpmn:documentation><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="E06" name="E06 Load goods; issue B/L; attest shipment"><bpmn:documentation>kind=EXTERNAL_MANUAL; segment=COMMON; path=MAIN; assumed duration days low/base/high=(0.5, 1, 2)</bpmn:documentation><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="E07" name="E07 Upload invoice &amp; bill of lading"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.1, 0.5, 1)</bpmn:documentation><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="E08" name="E08 Automated 4-document matching"><bpmn:documentation>kind=AUTO; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.0, 0.0, 0.0)</bpmn:documentation><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="E08x" name="E08x Manual review; exporter corrects; revalidate"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MISMATCH; assumed duration days low/base/high=(2, 3, 5)</bpmn:documentation><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="E09" name="E09 Pre-release KYC/AML screening"><bpmn:documentation>kind=AUTO; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.0, 0.0, 0.0)</bpmn:documentation><bpmn:incoming>F11</bpmn:incoming><bpmn:incoming>F13</bpmn:incoming><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="E09x" name="E09x Compliance investigation (Frozen)"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=AML; assumed duration days low/base/high=(2, 3, 5)</bpmn:documentation><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing><bpmn:outgoing>F18</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="E10" name="E10 Guarded release to exporter"><bpmn:documentation>kind=AUTO; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.0, 0.0, 0.0)</bpmn:documentation><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="E11" name="E11 Acknowledge receipt (observation)"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0, 0.1, 0.5)</bpmn:documentation><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="E12" name="E12 Read-only audit trail available"><bpmn:documentation>kind=AUTO; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.0, 0.0, 0.0)</bpmn:documentation><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing></bpmn:serviceTask>
