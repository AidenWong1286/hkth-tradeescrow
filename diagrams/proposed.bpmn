<bpmn:flowNodeRef>start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E01</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_proposed_1" name="Bank H escrow contract &amp; services">
<bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end_ref</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
