<bpmn:sequenceFlow id="F10" sourceRef="B07" targetRef="B08"/>
<bpmn:sequenceFlow id="F11" sourceRef="B08" targetRef="B09"/>
<bpmn:sequenceFlow id="F12" sourceRef="B09" targetRef="G2"/>
<bpmn:sequenceFlow id="F13" sourceRef="G2" targetRef="B10" name="clear"/>
<bpmn:sequenceFlow id="F14" sourceRef="G2" targetRef="B09x" name="alert"/>
<bpmn:sequenceFlow id="F15" sourceRef="B09x" targetRef="B10" name="cleared"/>
<bpmn:sequenceFlow id="F16" sourceRef="B10" targetRef="B11"/>
<bpmn:sequenceFlow id="F17" sourceRef="B11" targetRef="B12"/>
<bpmn:sequenceFlow id="F18" sourceRef="B12" targetRef="end"/>
</bpmn:process>
