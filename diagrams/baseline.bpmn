<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_baseline" targetNamespace="https://example.org/hkth-tradeescrow" exporter="tradeescrow/make_diagrams.py" exporterVersion="1.0">
<bpmn:collaboration id="Collab_baseline"><bpmn:participant id="Pool_baseline" name="Traditional open-account settlement (baseline)" processRef="Process_baseline"/></bpmn:collaboration>
<bpmn:process id="Process_baseline" isExecutable="false"><bpmn:laneSet id="LS_baseline">
<bpmn:lane id="Lane_baseline_0" name="Importer (HK)">
<bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B06</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B06x</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B07</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B08</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_baseline_1" name="Bank H (importer's bank)">
<bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B09</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B09x</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B10</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_baseline_2" name="Bank O (exporter's bank)">
<bpmn:flowNodeRef>B11</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_baseline_3" name="Exporter (TH)">
<bpmn:flowNodeRef>start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B01</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B04</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B05</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B12</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_baseline_4" name="Logistics / Customs">
<bpmn:flowNodeRef>B02</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B03</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start" name="Contract signed"><bpmn:outgoing>F0</bpmn:outgoing></bpmn:startEvent>
<bpmn:endEvent id="end" name="Payment reconciled"><bpmn:incoming>F18</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="G1" name="Documents OK?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G2" name="Screening alert?"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="B01" name="B01 Prepare goods &amp; export declaration"><bpmn:documentation>kind=MANUAL; segment=COMMON; path=MAIN; assumed duration days low/base/high=(3, 5, 7)</bpmn:documentation><bpmn:incoming>F0</bpmn:incoming><bpmn:outgoing>F1</bpmn:outgoing></bpmn:userTask>
<bpmn:manualTask id="B02" name="B02 Clear export customs"><bpmn:documentation>kind=EXTERNAL_MANUAL; segment=COMMON; path=MAIN; assumed duration days low/base/high=(0.5, 1, 2)</bpmn:documentation><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="B03" name="B03 Load goods &amp; issue bill of lading"><bpmn:documentation>kind=EXTERNAL_MANUAL; segment=COMMON; path=MAIN; assumed duration days low/base/high=(0.5, 1, 2)</bpmn:documentation><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="B04" name="B04 Compile invoice &amp; shipping documents"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.5, 1, 2)</bpmn:documentation><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="B05" name="B05 Send documents to importer"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.5, 2, 4)</bpmn:documentation><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="B06" name="B06 Check documents against contract"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.5, 1, 2)</bpmn:documentation><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="B06x" name="B06x Raise discrepancy; obtain corrected documents"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MISMATCH; assumed duration days low/base/high=(2, 3, 5)</bpmn:documentation><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask>
<bpmn:task id="B07" name="B07 Wait for agreed payment term"><bpmn:documentation>kind=WAIT; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0, 0, 0)</bpmn:documentation><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
<bpmn:userTask id="B08" name="B08 Initiate payment instruction"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.25, 0.5, 1)</bpmn:documentation><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="B09" name="B09 Payment screening &amp; approval"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.25, 1, 2)</bpmn:documentation><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="B09x" name="B09x Compliance investigation of alert"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=AML; assumed duration days low/base/high=(2, 3, 5)</bpmn:documentation><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="B10" name="B10 Send cross-border payment message"><bpmn:documentation>kind=AUTO; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.1, 0.5, 1)</bpmn:documentation><bpmn:incoming>F13</bpmn:incoming><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="B11" name="B11 Receive, screen &amp; credit exporter"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.25, 1, 2)</bpmn:documentation><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="B12" name="B12 Reconcile receipt against invoice"><bpmn:documentation>kind=MANUAL; segment=SETTLEMENT; path=MAIN; assumed duration days low/base/high=(0.25, 0.5, 1)</bpmn:documentation><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:userTask>
